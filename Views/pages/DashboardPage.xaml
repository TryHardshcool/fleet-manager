<Page x:Class="GestionVehicule.Views.pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:controls="clr-namespace:GestionVehicule.Controls"
      mc:Ignorable="d"
      Background="#090B12"
      Title="DashboardPage"
      Loaded="Page_Loaded">


    <Grid Grid.Column="1" Margin="36,30,36,20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="69"/>
            <RowDefinition Height="198"/>
            <RowDefinition Height="63"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Margin="0,0,0,123" Grid.RowSpan="2">

            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Dashboard" FontSize="30" FontWeight="Bold" Foreground="White"/>
                <TextBlock x:Name="WelcomeText" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">

                <Border Background="{StaticResource CardBrush}" CornerRadius="20" Width="42" Height="42" Margin="0,0,10,0">
                    <materialDesign:PackIcon Kind="BellOutline" Width="20" Height="20" Foreground="White"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <Border Background="{StaticResource AccentBrush}" CornerRadius="21" Width="42" Height="42">
                    <materialDesign:PackIcon Kind="AccountCircle" Width="24" Height="24" Foreground="White"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

            </StackPanel>

        </DockPanel>

        <!-- Cartes statistiques -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,20,0,5">

            <Border Style="{StaticResource StatCard}">
                <StackPanel Margin="22">
                    <Border Width="46" Height="46" CornerRadius="14" Background="{StaticResource AccentSoftBrush}">
                        <materialDesign:PackIcon Kind="CarMultiple" Width="24" Height="24"
                                                  Foreground="{StaticResource AccentBrush}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="TotalVehiculesText" Margin="0,14,0,0" Text="0" FontSize="26" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Véhicules" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource StatCard}">
                <StackPanel Margin="22">
                    <Border Width="46" Height="46" CornerRadius="14" Background="{StaticResource AccentSoftBrush}">
                        <materialDesign:PackIcon Kind="CheckCircleOutline" Width="24" Height="24"
                                                  Foreground="{StaticResource AccentBrush}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="DisponiblesText" Margin="0,14,0,0" Text="0" FontSize="26" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Disponibles" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource StatCard}">
                <StackPanel Margin="22">
                    <Border Width="46" Height="46" CornerRadius="14" Background="#3A2E1E">
                        <materialDesign:PackIcon Kind="ClipboardAccountOutline" Width="24" Height="24"
                                                  Foreground="{StaticResource WarningBrush}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="AllouesText" Margin="0,14,0,0" Text="0" FontSize="26" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Alloués" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource StatCard}">
                <StackPanel Margin="22">
                    <Border Width="46" Height="46" CornerRadius="14" Background="#3A2323">
                        <materialDesign:PackIcon Kind="Tools" Width="24" Height="24"
                                                  Foreground="{StaticResource DangerBrush}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="MaintenanceText" Margin="0,14,0,0" Text="0" FontSize="26" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Maintenance" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
                </StackPanel>
            </Border>

        </UniformGrid>

        <!-- Barre de recherche -->
        <DockPanel Grid.Row="2" VerticalAlignment="Center" Height="46">

            <Border Background="{StaticResource CardBrush}" CornerRadius="14" Width="360" Height="46">
                <DockPanel Margin="16,0">
                    <materialDesign:PackIcon Kind="Magnify" Width="18" Height="18"
                                              Foreground="{StaticResource TextSecondaryBrush}"
                                              VerticalAlignment="Center"/>
                    <TextBox x:Name="RechercheTextBox"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="White"
                             CaretBrush="White"
                             VerticalContentAlignment="Center"
                             Margin="10,0,0,0"
                             materialDesign:HintAssist.Hint="Rechercher un véhicule..."
                             materialDesign:HintAssist.Foreground="{StaticResource TextSecondaryBrush}"
                             KeyUp="RechercheTextBox_KeyUp"/>
                </DockPanel>
            </Border>

            <Button DockPanel.Dock="Right"
                    Width="170" Height="46"
                    HorizontalAlignment="Right"
                    Background="{StaticResource AccentBrush}"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Content="+ Ajouter un véhicule" Click="Button_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="14"/>
                    </Style>
                </Button.Resources>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

        </DockPanel>

        <!-- Cartes véhicules : generees dynamiquement depuis VehiculesItemsControl.ItemsSource -->
        <ScrollViewer Grid.Row="3" Margin="0,15,0,0" VerticalScrollBarVisibility="Auto">

            <Grid>

                <ItemsControl x:Name="VehiculesItemsControl">

                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource VehicleCard}">
                                <StackPanel Margin="22">

                                    <Border Width="64" Height="64" CornerRadius="32"
                                                Background="{Binding BadgeBrush}"
                                                HorizontalAlignment="Center">
                                        <materialDesign:PackIcon Kind="{Binding IconKind}" Width="32" Height="32"
                                                                      Foreground="{Binding AccentBrush}"
                                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <TextBlock Text="{Binding NomComplet}" Margin="0,16,0,2" FontWeight="Bold" FontSize="17"
                                                   Foreground="White" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Immatriculation}" Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="13" HorizontalAlignment="Center"/>

                                    <Border Style="{StaticResource StatusChip}" Background="{Binding BadgeBrush}" Margin="0,14,0,16">
                                        <TextBlock Text="{Binding StatutLabel}" Foreground="{Binding AccentBrush}"
                                                       FontSize="12" FontWeight="SemiBold"/>
                                    </Border>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Style="{StaticResource IconActionButton}" ToolTip="Voir les détails"
                                                    Margin="0,0,8,0" Tag="{Binding}" Click="VoirButton_Click">
                                            <materialDesign:PackIcon Kind="EyeOutline" Width="18" Height="18"/>
                                        </Button>
                                        <Button Style="{StaticResource IconActionButton}" ToolTip="Modifier"
                                                    Margin="0,0,8,0" Tag="{Binding}" Click="ModifierButton_Click">
                                            <materialDesign:PackIcon Kind="PencilOutline" Width="18" Height="18" Foreground="{StaticResource AccentBrush}"/>
                                        </Button>
                                        <Button Style="{StaticResource IconActionButton}" ToolTip="Supprimer"
                                                    Tag="{Binding}" Click="SupprimerButton_Click">
                                            <materialDesign:PackIcon Kind="TrashCanOutline" Width="18" Height="18" Foreground="{StaticResource DangerBrush}"/>
                                        </Button>
                                    </StackPanel>

                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>

                </ItemsControl>

                <!-- Message affiche quand la liste est vide -->
                <TextBlock x:Name="AucunResultatText"
                               Text="Aucun véhicule trouvé."
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Top"
                               Margin="0,40,0,0"
                               Visibility="Collapsed"/>

            </Grid>

        </ScrollViewer>

        <!-- Overlay de chargement : place en dernier pour etre au-dessus de tout -->
        <controls:LoadingOverlay x:Name="Loader" Grid.RowSpan="4"/>

    </Grid>


</Page>
