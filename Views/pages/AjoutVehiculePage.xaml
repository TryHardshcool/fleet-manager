<Page x:Class="GestionVehicule.Views.pages.AjoutVehiculePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:controls="clr-namespace:GestionVehicule.Controls"
      mc:Ignorable="d"
      Background="#090B12"
      Title="AjoutVehiculePage"
      Loaded="Page_Loaded">

    <Grid Margin="36,30,36,20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto" MinHeight="90"/>
        </Grid.RowDefinitions>

        <!-- ===================== HEADER ===================== -->
        <DockPanel Grid.Row="0" Margin="0,0,0,24">

            <StackPanel DockPanel.Dock="Left">
                <TextBlock x:Name="TitreText" Text="Ajouter un véhicule" FontSize="30" FontWeight="Bold" Foreground="White"/>
                <TextBlock x:Name="SousTitreText" Text="Renseignez les informations du nouveau véhicule"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>

            <Button x:Name="RetourButton"
                    DockPanel.Dock="Right"
                    HorizontalAlignment="Right"
                    Width="120" Height="42"
                    Style="{StaticResource SecondaryButton}"
                    Click="RetourButton_Click">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ArrowLeft" Width="16" Height="16" VerticalAlignment="Center"/>
                    <TextBlock Text="Retour" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

        </DockPanel>

        <!-- ===================== CORPS DU FORMULAIRE ===================== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,20" Grid.RowSpan="2">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- ============ COLONNE GAUCHE : informations générales ============ -->
                <StackPanel Grid.Column="0">

                    <Border Style="{StaticResource FormSectionCard}">
                        <StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,22">
                                <Border Style="{StaticResource SectionIconBadge}">
                                    <materialDesign:PackIcon Kind="CardAccountDetailsOutline" Width="22" Height="22"
                                                              Foreground="{StaticResource AccentBrush}"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Informations générales" Style="{StaticResource SectionTitle}"
                                           Margin="14,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>

                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="MARQUE" Style="{StaticResource FormLabel}"/>
                                    <TextBox x:Name="MarqueTextBox"
                                             Style="{StaticResource FormTextBox}"
                                             materialDesign:HintAssist.Hint="ex: Toyota"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="MODÈLE" Style="{StaticResource FormLabel}"/>
                                    <TextBox x:Name="ModeleTextBox"
                                             Style="{StaticResource FormTextBox}"
                                             materialDesign:HintAssist.Hint="ex: Corolla"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,22">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="IMMATRICULATION" Style="{StaticResource FormLabel}"/>
                                    <TextBox x:Name="ImmatriculationTextBox"
                                             Style="{StaticResource FormTextBox}"
                                             materialDesign:HintAssist.Hint="ex: DK-245-AA"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="ANNÉE" Style="{StaticResource FormLabel}"/>
                                    <TextBox x:Name="AnneeTextBox"
                                             Style="{StaticResource FormTextBox}"
                                             materialDesign:HintAssist.Hint="ex: 2022"
                                             MaxLength="4"
                                             PreviewTextInput="AnneeTextBox_PreviewTextInput"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel>
                                <TextBlock Text="COULEUR" Style="{StaticResource FormLabel}"/>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="CouleurBlanc" GroupName="Couleur"
                                                 Style="{StaticResource ColorSwatchButton}"
                                                 Background="#FFFFFF" Tag="Blanc"/>
                                    <RadioButton x:Name="CouleurNoir" GroupName="Couleur"
                                                 Style="{StaticResource ColorSwatchButton}"
                                                 Background="#1A1A1A" Tag="Noir"/>
                                    <RadioButton x:Name="CouleurGris" GroupName="Couleur"
                                                 Style="{StaticResource ColorSwatchButton}"
                                                 Background="#8C8C8C" Tag="Gris"/>
                                    <RadioButton x:Name="CouleurRouge" GroupName="Couleur"
                                                 Style="{StaticResource ColorSwatchButton}"
                                                 Background="#D32F2F" Tag="Rouge"/>
                                    <RadioButton x:Name="CouleurBleu" GroupName="Couleur"
                                                 Style="{StaticResource ColorSwatchButton}"
                                                 Background="#1565C0" Tag="Bleu"/>
                                    <RadioButton x:Name="CouleurVert" GroupName="Couleur"
                                                 Style="{StaticResource ColorSwatchButton}"
                                                 Background="#2E7D32" Tag="Vert"/>
                                </StackPanel>
                            </StackPanel>

                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- ============ COLONNE DROITE : statut ============ -->
                <StackPanel Grid.Column="2">

                    <Border Style="{StaticResource FormSectionCard}">
                        <StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                <Border Style="{StaticResource SectionIconBadge}">
                                    <materialDesign:PackIcon Width="22" Height="22"
                                                              Foreground="{StaticResource AccentBrush}"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="StatutSectionTitre" Text="Statut initial" Style="{StaticResource SectionTitle}"
                                           Margin="14,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel>
                                <RadioButton x:Name="StatutDisponible" GroupName="Statut"
                                             Style="{StaticResource StatusToggleChip}"
                                             Content="Disponible" Tag="disponible"
                                             HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                                <RadioButton x:Name="StatutAlloue" GroupName="Statut"
                                             Style="{StaticResource StatusToggleChip}"
                                             Content="Alloué" Tag="en_service"
                                             HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                                <RadioButton x:Name="StatutMaintenance" GroupName="Statut"
                                             Style="{StaticResource StatusToggleChip}"
                                             Content="Maintenance" Tag="en_maintenance"
                                             HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                            </StackPanel>

                        </StackPanel>
                    </Border>

                </StackPanel>

            </Grid>

        </ScrollViewer>

        <!-- ===================== BARRE D'ACTIONS ===================== -->
        <DockPanel Grid.Row="2" Margin="0,20,0,21">

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">

                <Button x:Name="AnnulerButton"
                        Width="140" Style="{StaticResource SecondaryButton}"
                        Content="Annuler" Margin="0,0,12,0"
                        Click="AnnulerButton_Click"/>

                <Button x:Name="EnregistrerButton"
                        Width="230" Style="{StaticResource PrimaryButton}"
                        Click="EnregistrerButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ContentSaveOutline" Width="18" Height="18" VerticalAlignment="Center"/>
                        <TextBlock x:Name="EnregistrerButtonText" Text="Enregistrer le véhicule" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

            </StackPanel>

        </DockPanel>

        <!-- Overlay de chargement : place en dernier pour etre au-dessus de tout -->
        <controls:LoadingOverlay x:Name="Loader" Grid.RowSpan="3"/>

    </Grid>

</Page>
