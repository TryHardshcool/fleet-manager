<Page x:Class="GestionVehicule.Views.pages.VehiculeDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d"
      Background="#090B12"
      Title="VehiculeDetailsPage"
      Loaded="Page_Loaded">

    <Page.Resources>

        <!-- Ligne d'info de la fiche technique : icone + libelle + valeur -->
        <Style x:Key="FicheRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,20"/>
        </Style>

        <Style x:Key="FicheIconBadge" TargetType="Border">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="#1B1F2C"/>
        </Style>

    </Page.Resources>

    <Grid Margin="36,30,36,20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto" MinHeight="80"/>
        </Grid.RowDefinitions>

        <!-- ===================== HEADER ===================== -->
        <DockPanel Grid.Row="0" Margin="0,0,0,24">

            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Détails du véhicule" FontSize="30" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Fiche complète et historique"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>

            <Button x:Name="RetourButton"
                    DockPanel.Dock="Right"
                    HorizontalAlignment="Right"
                    Width="120" Height="42"
                    Style="{StaticResource SecondaryButton}"
                    Click="RetourButton_Click">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ArrowLeft" Width="16" Height="16" VerticalAlignment="Center"/>
                    <TextBlock Text="Retour" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

        </DockPanel>

        <!-- ===================== CORPS ===================== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">

            <StackPanel>

                <!-- ============ BANNIERE HERO ============ -->
                <Border CornerRadius="24" Padding="36" Margin="0,0,0,20">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#16211E" Offset="0"/>
                            <GradientStop Color="#1D1F2C" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Icone vehicule teintee de la couleur reelle du vehicule -->
                        <Border Grid.Column="0" Width="96" Height="96" CornerRadius="48"
                                x:Name="IconeBadge" Background="{StaticResource AccentSoftBrush}">
                            <materialDesign:PackIcon x:Name="IconeVehicule" Kind="Car" Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Foreground="{StaticResource AccentBrush}"/>
                        </Border>

                        <!-- Nom, statut, date d'ajout -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock x:Name="NomCompletText" Text="—" FontSize="28" FontWeight="Bold" Foreground="White"/>

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Border x:Name="StatutBadge" Style="{StaticResource StatusChip}" Padding="14,6">
                                    <TextBlock x:Name="StatutText" Text="—" FontSize="12" FontWeight="SemiBold"/>
                                </Border>
                                <TextBlock x:Name="DateAjoutText" Text="Ajouté le —"
                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                                           VerticalAlignment="Center" Margin="14,0,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Plaque d'immatriculation stylisee -->
                        <Border Grid.Column="3" VerticalAlignment="Center" CornerRadius="8" BorderThickness="2"
                                BorderBrush="#0A0A0A" Background="#F4F4F2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Bandeau lateral façon plaque officielle -->
                                <Border Grid.Column="0" Background="#1565C0" CornerRadius="6,0,0,6" Width="26">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <materialDesign:PackIcon Kind="Star" Width="10" Height="10" Foreground="White" HorizontalAlignment="Center"/>
                                        <TextBlock Text="SN" Foreground="White" FontSize="10" FontWeight="Bold"
                                                   HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock x:Name="ImmatriculationPlateText"
                                           Grid.Column="1"
                                           Text="—"
                                           FontFamily="Consolas"
                                           FontSize="22" FontWeight="Bold"
                                           Foreground="#0A0A0A"
                                           Padding="18,10"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                    </Grid>
                </Border>

                <!-- ============ FICHE TECHNIQUE + HISTORIQUE ============ -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.3*"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Fiche technique -->
                    <Border Grid.Column="0" Style="{StaticResource FormSectionCard}">
                        <StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,26">
                                <Border Style="{StaticResource SectionIconBadge}">
                                    <materialDesign:PackIcon Kind="CardAccountDetailsOutline" Width="22" Height="22"
                                                              Foreground="{StaticResource AccentBrush}"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Fiche technique" Style="{StaticResource SectionTitle}"
                                           Margin="14,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>

                            <Grid Style="{StaticResource FicheRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource FicheIconBadge}">
                                    <materialDesign:PackIcon Kind="CarSide" Width="18" Height="18" Foreground="{StaticResource TextSecondaryBrush}"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="MARQUE" Style="{StaticResource FormLabel}" Margin="0,0,0,2"/>
                                    <TextBlock x:Name="MarqueText" Text="—" Foreground="White" FontSize="15" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Grid>

                            <Grid Style="{StaticResource FicheRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource FicheIconBadge}">
                                    <materialDesign:PackIcon Kind="TagOutline" Width="18" Height="18" Foreground="{StaticResource TextSecondaryBrush}"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="MODÈLE" Style="{StaticResource FormLabel}" Margin="0,0,0,2"/>
                                    <TextBlock x:Name="ModeleText" Text="—" Foreground="White" FontSize="15" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Grid>

                            <Grid Style="{StaticResource FicheRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource FicheIconBadge}">
                                    <materialDesign:PackIcon Kind="CalendarBlankOutline" Width="18" Height="18" Foreground="{StaticResource TextSecondaryBrush}"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="ANNÉE" Style="{StaticResource FormLabel}" Margin="0,0,0,2"/>
                                    <TextBlock x:Name="AnneeText" Text="—" Foreground="White" FontSize="15" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource FicheIconBadge}">
                                    <Ellipse Width="18" Height="18" x:Name="CouleurPastille" Fill="White"
                                             Stroke="#2A2E3F" StrokeThickness="1"/>
                                </Border>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="COULEUR" Style="{StaticResource FormLabel}" Margin="0,0,0,2"/>
                                    <TextBlock x:Name="CouleurText" Text="—" Foreground="White" FontSize="15" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Grid>

                        </StackPanel>
                    </Border>

                    <!-- Historique -->
                    <Border Grid.Column="2" Style="{StaticResource FormSectionCard}">
                        <StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,26">
                                <Border Style="{StaticResource SectionIconBadge}">
                                    <materialDesign:PackIcon Kind="History" Width="22" Height="22"
                                                              Foreground="{StaticResource AccentBrush}"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Historique" Style="{StaticResource SectionTitle}"
                                           Margin="14,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Timeline verticale -->
                            <Grid Margin="0,0,0,24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                    <Ellipse Width="12" Height="12" Fill="{StaticResource AccentBrush}"/>
                                    <Rectangle Width="2" Height="34" Fill="#2A2E3F" HorizontalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Création" Foreground="White" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock x:Name="CreeLeText" Text="—" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Ellipse Grid.Column="0" Width="12" Height="12" Fill="#2A2E3F" HorizontalAlignment="Center" VerticalAlignment="Top"/>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Dernière modification" Foreground="White" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock x:Name="ModifieLeText" Text="—" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>

                        </StackPanel>
                    </Border>

                </Grid>

            </StackPanel>

        </ScrollViewer>

        <!-- ===================== BARRE D'ACTIONS ===================== -->
        <DockPanel Grid.Row="2" Margin="0,20,0,21">

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">

                <Button x:Name="SupprimerButton"
                        Width="150" Height="50"
                        Background="Transparent"
                        Foreground="{StaticResource DangerBrush}"
                        BorderThickness="1.5"
                        Cursor="Hand"
                        Margin="0,0,12,0"
                        Click="SupprimerButton_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="14"/>
                        </Style>
                    </Button.Resources>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="#EF5C5C" BorderThickness="1.5" CornerRadius="14">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="TrashCanOutline" Width="16" Height="16" VerticalAlignment="Center"/>
                        <TextBlock Text="Supprimer" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="ModifierButton"
                        Width="200" Style="{StaticResource PrimaryButton}"
                        Click="ModifierButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="PencilOutline" Width="18" Height="18" VerticalAlignment="Center"/>
                        <TextBlock Text="Modifier ce véhicule" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

            </StackPanel>

        </DockPanel>

    </Grid>

</Page>
