<UserControl x:Class="GestionVehicule.Controls.LoadingOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Focusable="False"
             IsHitTestVisible="True"
             Visibility="Collapsed">

    <!--
        IsHitTestVisible="True" + un fond qui couvre tout : bloque les clics
        sur les elements en dessous pendant le chargement, sans avoir a
        desactiver chaque bouton/champ individuellement.
    -->

    <Grid Background="#CC090B12">

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

            <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                         IsIndeterminate="True"
                         Width="54" Height="54"
                         Foreground="{StaticResource AccentBrush}"/>

            <TextBlock x:Name="MessageText"
                       Text="Chargement..."
                       Foreground="White"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Margin="0,18,0,0"
                       HorizontalAlignment="Center"/>

        </StackPanel>

    </Grid>

</UserControl>
